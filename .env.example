# ==============================================================================
# Sayan Sentinel — environment configuration
# Copy to .env and fill in. Nothing in this file is a real credential.
# Anything left blank runs in its documented "not configured" state —
# Sentinel never fakes a feature because a credential is missing.
# ==============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Read by apps/web (Next.js) at build/runtime — must be prefixed
# NEXT_PUBLIC_ to be exposed to the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:4000
LOG_LEVEL=info

# --- Session / auth -----------------------------------------------------------
# Generate with: openssl rand -base64 32
SESSION_SECRET=
COOKIE_DOMAIN=localhost

# --- PostgreSQL ---------------------------------------------------------------
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel

# --- Redis / BullMQ -------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible; MinIO for local dev) ----------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=sentinel-artifacts
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true

# --- GitHub App -----------------------------------------------------------------
# Create at https://github.com/settings/apps/new — see docs/github-app.md
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=

# --- AI providers (all optional — leave unset to run deterministic-only) -----
# See docs/ai-security.md for the provider abstraction and how to add one.
AI_PROVIDER=none
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LOCAL_AI_BASE_URL=
AI_MONTHLY_BUDGET_USD=0
AI_PER_SCAN_BUDGET_USD=0

# --- HexStrike AI dynamic validation (optional) --------------------------------
# See docs/hexstrike-integration.md
HEXSTRIKE_ENABLED=false
HEXSTRIKE_BASE_URL=
HEXSTRIKE_API_KEY=

# --- Scope Guard / dynamic validation policy -----------------------------------
# Local lab mode allows localhost/private-network targets ONLY against the
# bundled demo fixture. Never enable this against a real deployment.
LOCAL_LAB_MODE=true
DYNAMIC_VALIDATION_MAX_TIER=1
DYNAMIC_VALIDATION_MAX_RPS=2
DYNAMIC_VALIDATION_MAX_REQUESTS=50
DYNAMIC_VALIDATION_TIMEOUT_MS=30000

# --- Deterministic scanners (paths resolved on worker container) --------------
SEMGREP_BIN=semgrep
GITLEAKS_BIN=gitleaks
OSV_SCANNER_BIN=osv-scanner
