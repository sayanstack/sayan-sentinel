{
  "name": "@sayan-sentinel/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "clean": "rimraf dist",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/terminus": "^11.1.1",
    "@sayan-sentinel/auth": "workspace:*",
    "@sayan-sentinel/config": "workspace:*",
    "@sayan-sentinel/database": "workspace:*",
    "@sayan-sentinel/findings": "workspace:*",
    "@sayan-sentinel/github": "workspace:*",
    "@sayan-sentinel/queue": "workspace:*",
    "@sayan-sentinel/policy-engine": "workspace:*",
    "@sayan-sentinel/security-core": "workspace:*",
    "@sayan-sentinel/shared": "workspace:*",
    "@sayan-sentinel/web-security-engine": "workspace:*",
    "bullmq": "^6.3.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsc-watch": "^6.2.1",
    "typescript": "^5.7.0"
  }
}
